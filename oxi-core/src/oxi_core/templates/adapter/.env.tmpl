# Pins this adapter when multiple `oxi.adapters` entry-points are installed
# in the same Python environment (e.g. dogfooding the bundled `_self`
# adapter alongside your own scaffold). Without a pin, oxi refuses to
# guess and exits with `multiple adapters installed`.
#
# Sourced automatically by tools that read .env (direnv, dotenv, etc.).
# To activate it in a plain shell: `set -a; source .env; set +a`
OXI_ADAPTER=oxi_adapter_{{PACKAGE_SUFFIX}}:Adapter
