"""Adapter for {{PROJECT_NAME}}.

Generated by `oxi init` on {{TODAY}}. This file is yours — edit the
fields marked "TUNE" when you need different paths or caps.

The Adapter class implements oxi's 10-method protocol. Any oxi engine
module reads configuration through `get_active_adapter()`; this class
is the single source of truth for what {{PROJECT_NAME}} looks like.
"""

from __future__ import annotations

from dataclasses import dataclass
from pathlib import Path

from oxi_core.adapter import (
    BudgetCaps,
    DispatchHost,
    DispatchPolicy,
    NamingConfig,
    PathsConfig,
    PromoteRecipe,
)


# ---- TUNE: paths ----------------------------------------------------------
# Where oxi writes its own state. Defaults put everything under <repo>/.oxi/.
_REPO_ROOT = Path("{{REPO_ROOT}}")
_OXI_DIR_NAME = ".oxi"


@dataclass(frozen=True)
class Adapter:
    """oxi adapter for {{PROJECT_NAME}}."""

    # ---- Identity ----

    def naming(self) -> NamingConfig:
        return NamingConfig(
            instance_name="{{PROJECT_NAME}}",
            branch_prefixes=("feat/", "fix/", "chore/"),
        )

    # ---- Paths ----

    def paths(self) -> PathsConfig:
        oxi_dir = _REPO_ROOT / _OXI_DIR_NAME
        return PathsConfig(
            repo_root=str(_REPO_ROOT),
            oxi_dir=_OXI_DIR_NAME,
            db_path=str(oxi_dir / "oxi.db"),
            brief_path=str(oxi_dir / "brief.md"),
            dashboard_path=str(oxi_dir / "dashboard.html"),
            release_lock_path=str(oxi_dir / "KILLSWITCH"),
            daily_recap_path=str(oxi_dir / "daily-recap.md"),
        )

    # ---- Budget ----

    def budget(self) -> BudgetCaps:
        return BudgetCaps(
            daily_soft_warn={{BUDGET_SOFT_WARN}},
            daily_hard_cap={{BUDGET_HARD_CAP}},
            per_task_opus={{BUDGET_PER_TASK_OPUS}},
            per_task_sonnet={{BUDGET_PER_TASK_SONNET}},
        )

    # ---- Target repo ----

    def github_repo(self) -> str:
        return "{{GITHUB_REPO}}"

    def roadmap_location(self) -> str:
        return "{{ROADMAP_LOCATION}}"

    def branch_prefixes(self) -> tuple[str, ...]:
        return ("feat/", "fix/", "chore/")

    # ---- Dispatch ----

    def dispatch_hosts(self) -> tuple[DispatchHost, ...]:
        oxi_dir = _REPO_ROOT / _OXI_DIR_NAME
        return (
            DispatchHost(
                name="local",
                ssh_alias=None,  # None = local; set alias for remote dispatch.
                max_concurrent={{MAX_CONCURRENT}},
                worktree_root=str(oxi_dir / "worktrees"),
            ),
        )

    def promote_recipe(self) -> PromoteRecipe | None:
        # No automatic staging→production promotion. If your project
        # needs it, populate a PromoteRecipe here; the oxi daily_promote
        # engine (when configured) will execute it.
        return None

    # ---- Plan tier + policy ----

    def plan_tier(self) -> str:
        return "{{PLAN_TIER}}"

    def policy(self) -> DispatchPolicy:
        return DispatchPolicy(
            skill_weights={},
            auto_merge={{AUTO_MERGE}},
            tier_zero_absorb=True,
        )
