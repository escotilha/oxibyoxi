[build-system]
requires = ["setuptools>=61.0", "wheel"]
build-backend = "setuptools.build_meta"

[project]
name = "oxi-adapter-{{ADAPTER_SLUG}}"
version = "0.0.1"
description = "oxi adapter for {{PROJECT_NAME}}."
readme = "README.md"
license = { text = "MIT" }
requires-python = ">=3.11"
dependencies = [
  "oxi-core>=0.0.0",
]

[tool.setuptools.packages.find]
where = ["src"]
include = ["oxi_adapter_{{PACKAGE_SUFFIX}}*"]

[tool.ruff]
line-length = 100
target-version = "py311"
